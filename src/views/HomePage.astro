---
import Layout from "../layouts/Layout.astro";
import SiteHero from "../components/SiteHero.astro";
import SiteCta from "../components/SiteCta.astro";

const title = "Desarrollo web para autónomos y pequeños negocios | dzf soft";
const description =
  "Creo páginas web profesionales para autónomos, comercios y pequeñas empresas. Cuéntame qué necesitas y encontramos una solución clara para tu negocio.";

const services = [
  {
    title: "Web para tu negocio",
    description: "Una presencia profesional para explicar qué haces y facilitar que tus clientes te encuentren.",
  },
  {
    title: "Web corporativa",
    description: "Presenta tu empresa, tus servicios y tu equipo con una web clara y cuidada.",
  },
  {
    title: "Tienda online",
    description: "Empieza a vender tus productos por Internet con una tienda sencilla de gestionar.",
  },
  {
    title: "WordPress y WooCommerce",
    description: "Actualiza tus contenidos y gestiona tu tienda sin depender de la parte técnica.",
  },
  {
    title: "Rediseño y desarrollo a medida",
    description: "Renueva una web que se ha quedado atrás o plantea una solución para una necesidad concreta.",
  },
];

const audiences = [
  "Tienes un pequeño negocio o comercio y necesitas una web profesional.",
  "Trabajas por cuenta propia y quieres presentar tus servicios.",
  "Quieres vender tus productos en una tienda online.",
  "Tu web actual ya no representa tu negocio o no funciona bien en móvil.",
  "Tienes una idea y necesitas ayuda para definir qué solución encaja.",
];

const reasons = [
  "Hablas directamente conmigo, sin intermediarios.",
  "Te explico las opciones con claridad y sin tecnicismos.",
  "La solución se adapta a las necesidades reales de tu negocio.",
  "Podemos empezar por lo esencial y ampliar la web más adelante.",
  "Elijo la tecnología por lo que el proyecto necesita, no al revés.",
];

const steps = [
  "Me cuentas tu idea",
  "Analizamos qué necesitas",
  "Te propongo una solución",
  "Desarrollo la web",
  "Revisamos el resultado",
  "La publicamos",
];
---

<Layout title={title} description={description}>
  <main>
    <SiteHero
      eyebrow="Desarrollo web cercano y a medida"
      title="Creo webs profesionales para autónomos y pequeños negocios"
      description="Te ayudo a tener una web clara, cuidada y adaptada a tu negocio. No necesitas saber de programación: cuéntame qué quieres conseguir y buscamos juntos la mejor forma de hacerlo."
      primaryHref="/presupuesto"
      primaryLabel="Pedir presupuesto"
      secondaryHref="/services"
      secondaryLabel="Ver servicios"
    />

    <section class="section home-intro">
      <div class="container intro-layout">
        <div class="intro-copy">
          <span class="section-eyebrow">Desarrollo web con trato directo</span>
          <h2>Una web profesional, pensada para tu día a día</h2>
          <p>
            Soy desarrollador web y ayudo a negocios y profesionales a tener una presencia online
            profesional, clara y adaptada a sus necesidades. Trabajo contigo para entender lo que
            necesitas y explicarte cada paso de forma sencilla.
          </p>
          <a class="text-link" href="/about">Conoce un poco más sobre mí <span aria-hidden="true">→</span></a>
        </div>
        <aside class="intro-card card">
          <p class="intro-card-label">La experiencia, sin complicaciones</p>
          <p class="intro-card-date">Desde 2015</p>
          <p class="intro-card-copy">Acompañando proyectos web desde la idea hasta su publicación.</p>
        </aside>
      </div>
    </section>

    <section class="section home-services">
      <div class="container">
        <div class="section-heading">
          <span class="section-eyebrow">En qué puedo ayudarte</span>
          <h2>Una solución para cada tipo de proyecto</h2>
          <p>Desde una primera web hasta una tienda online o una mejora para tu sitio actual.</p>
        </div>
        <div class="home-service-grid">
          {services.map((service) => (
            <a class="card home-service-card" href="/services#servicios">
              <span class="service-card-mark" aria-hidden="true">↗</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <span class="text-link">Ver servicios <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-audience">
      <div class="container audience-layout">
        <div class="section-heading">
          <span class="section-eyebrow">¿Te suena alguna de estas situaciones?</span>
          <h2>Una web para el momento en el que está tu negocio</h2>
          <p>No hace falta tenerlo todo definido para empezar a hablar.</p>
        </div>
        <ul class="audience-list">
          {audiences.map((audience) => (
            <li>
              <span class="list-check" aria-hidden="true">✓</span>
              <span>{audience}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section home-reasons">
      <div class="container">
        <div class="section-heading">
          <span class="section-eyebrow">Una forma de trabajar sencilla</span>
          <h2>Trato directo y decisiones con sentido</h2>
          <p>El objetivo es que tengas claro qué hacemos y por qué, de principio a fin.</p>
        </div>
        <ul class="reason-grid">
          {reasons.map((reason) => (
            <li class="card reason-card">
              <span class="reason-mark" aria-hidden="true">✓</span>
              <span>{reason}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section home-process">
      <div class="container">
        <div class="section-heading">
          <span class="section-eyebrow">Paso a paso</span>
          <h2>Así trabajaremos en tu proyecto</h2>
          <p>Un proceso claro, con tu participación en las decisiones importantes.</p>
        </div>
        <ol class="process-grid">
          {steps.map((step, index) => (
            <li>
              <span class="process-number" aria-hidden="true">{index + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <SiteCta
      title="¿Tienes un proyecto en mente?"
      description="No necesitas saber de programación. Cuéntame qué necesitas y hablamos para ver cómo puedo ayudarte."
    />
  </main>
</Layout>

<style>
  .section-heading {
    max-width: 700px;
  }

  .section-heading h2,
  .intro-copy h2 {
    margin-top: 0.65rem;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .section-heading > p,
  .intro-copy > p {
    margin-top: 0.8rem;
    max-width: 620px;
    color: var(--color-text-soft);
    line-height: 1.7;
  }

  .section-eyebrow {
    color: var(--accent-start);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.035em;
  }

  .home-intro {
    background: var(--color-bg-soft);
  }

  .intro-layout {
    display: grid;
    align-items: center;
    gap: 2rem;
  }

  .intro-copy {
    max-width: 650px;
  }

  .intro-card {
    max-width: 420px;
    width: 100%;
    border-left: 3px solid var(--accent-mid);
  }

  .intro-card-label {
    color: var(--color-text-soft);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .intro-card-date {
    margin-top: 0.5rem;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .intro-card-copy {
    margin-top: 0.5rem;
    color: var(--color-text-soft);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    color: var(--accent-start);
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .home-service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 230px;
  }

  .service-card-mark,
  .reason-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    flex: 0 0 auto;
    color: var(--accent-mid);
    background: rgba(99, 102, 241, 0.1);
    border-radius: 0.65rem;
    font-weight: 700;
  }

  .home-service-card h3 {
    margin-top: 1rem;
    font-size: 1.08rem;
  }

  .home-service-card p {
    margin-top: 0.5rem;
    color: var(--color-text-soft);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .home-service-card .text-link {
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.9rem;
  }

  .home-audience {
    background: var(--color-bg-soft);
  }

  .audience-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .audience-list,
  .reason-grid {
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .audience-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius);
  }

  .list-check {
    color: var(--accent-mid);
    font-weight: 800;
  }

  .reason-grid {
    margin-top: 2rem;
  }

  .reason-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.15rem;
  }

  .reason-mark {
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
  }

  .process-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
    margin-top: 2rem;
  }

  .process-grid li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-weight: 600;
  }

  .process-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    flex: 0 0 auto;
    color: white;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    border-radius: 50%;
  }

  @media (min-width: 640px) {
    .home-service-grid,
    .reason-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 800px) {
    .intro-layout,
    .audience-layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
      gap: 4rem;
    }

    .home-service-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .process-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem 2rem;
    }
  }
</style>
