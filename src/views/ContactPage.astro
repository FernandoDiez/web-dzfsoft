---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getLang, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/translations';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const descriptionByLang: Record<Lang, string> = {
  en: "Contact dzf soft — tell us about your project and we'll get back to you.",
  es: 'Contacta a dzf soft — cuentanos sobre tu proyecto y te responderemos a la brevedad.',
};
---

<Layout title={t('contact.title')} description={descriptionByLang[lang]}>
  <section class="section contact-page">
    <div class="container contact-inner">
      <div class="contact-header">
        <h1 class="page-title">{t('contact.title')}</h1>
        <p class="page-sub">{t('contact.sub')}</p>
      </div>
      <div class="form-wrapper">
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-page {
    min-height: calc(100vh - 64px);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .contact-inner {
      grid-template-columns: 1fr 2fr;
    }
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .page-title {
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.15;
  }

  .page-sub {
    font-size: 1rem;
    color: var(--color-text-soft);
    line-height: 1.7;
  }

  .form-wrapper {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: calc(var(--radius) * 1.5);
    padding: 2rem;
  }
</style>
