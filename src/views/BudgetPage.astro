---
import Layout from "../layouts/Layout.astro";
import SiteHero from "../components/SiteHero.astro";
import StaticFormNotice from "../components/StaticFormNotice.astro";

const title = "Pedir presupuesto para tu página web | dzf soft";
const description =
  "Cuéntame qué necesita tu negocio para preparar una propuesta web a tu medida. No necesitas tenerlo todo decidido para solicitar presupuesto.";

const projectTypes = [
  "Una página web",
  "Una tienda online",
  "Renovar mi web actual",
  "WordPress",
  "Una funcionalidad específica",
  "Una aplicación web",
  "No estoy seguro / necesito asesoramiento",
];

const budgetRanges = [
  "Menos de 500 €",
  "500 – 1.000 €",
  "1.000 – 2.000 €",
  "2.000 – 5.000 €",
  "Más de 5.000 €",
  "No lo sé todavía",
];

const timelines = [
  "Lo antes posible",
  "En las próximas semanas",
  "En los próximos meses",
  "No tengo una fecha concreta",
];
---

<Layout title={title} description={description}>
  <main>
    <SiteHero
      eyebrow="Pedir presupuesto"
      title="Cuéntame tu proyecto"
      description="No necesitas saber exactamente qué necesitas. Cuéntame tu situación, aunque solo tengas una idea inicial, y te ayudaré a encontrar una solución adecuada para tu negocio."
    />

    <section class="section budget-section">
      <div class="container budget-layout">
        <aside class="budget-aside">
          <span class="section-eyebrow">Sin tecnicismos y sin compromiso</span>
          <h2>Una primera conversación para entender tu idea</h2>
          <p>
            Cuanta más información tenga, mejor podré hacerme una idea del proyecto. Responde solo
            a lo que ya sepas: no pasa nada si todavía tienes dudas.
          </p>
          <ol class="budget-points">
            <li><span aria-hidden="true">1</span> Me cuentas qué quieres conseguir.</li>
            <li><span aria-hidden="true">2</span> Revisamos juntos lo que necesitas.</li>
            <li><span aria-hidden="true">3</span> Te propongo cómo podemos avanzar.</li>
          </ol>
        </aside>

        <form class="budget-form card" data-static-form>
          <fieldset class="form-section">
            <legend>Datos de contacto</legend>
            <div class="form-grid">
              <div class="form-field">
                <label for="budget-name">Nombre <span aria-hidden="true">*</span></label>
                <input id="budget-name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="form-field">
                <label for="budget-business">Empresa o negocio <span class="optional">(opcional)</span></label>
                <input id="budget-business" name="business" type="text" autocomplete="organization" />
              </div>
              <div class="form-field">
                <label for="budget-email">Email <span aria-hidden="true">*</span></label>
                <input
                  id="budget-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                />
              </div>
              <div class="form-field">
                <label for="budget-phone">Teléfono <span class="optional">(opcional)</span></label>
                <input id="budget-phone" name="phone" type="tel" autocomplete="tel" />
              </div>
            </div>
          </fieldset>

          <fieldset class="form-section">
            <legend>¿Qué necesitas? <span aria-hidden="true">*</span></legend>
            <p class="field-help">Elige la opción que más se acerque a tu idea.</p>
            <div class="choice-grid">
              {projectTypes.map((type, index) => (
                <label class="choice-card">
                  <input
                    type="radio"
                    name="project-type"
                    value={type}
                    required={index === 0}
                  />
                  <span>{type}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="form-section">
            <legend>¿Tienes actualmente una web?</legend>
            <div class="choice-inline">
              <label class="choice-card">
                <input type="radio" name="current-website" value="yes" />
                <span>Sí</span>
              </label>
              <label class="choice-card">
                <input type="radio" name="current-website" value="no" />
                <span>No</span>
              </label>
              <label class="choice-card">
                <input type="radio" name="current-website" value="unsure" />
                <span>No estoy seguro</span>
              </label>
            </div>
            <div class="form-field website-url">
              <label for="budget-website">URL de tu web actual <span class="optional">(opcional)</span></label>
              <input
                id="budget-website"
                name="website-url"
                type="url"
                inputmode="url"
                autocomplete="url"
                placeholder="https://"
                aria-describedby="budget-website-help"
              />
              <span class="field-help" id="budget-website-help">
                Si ya tienes web, puedes compartir su dirección aquí.
              </span>
            </div>
          </fieldset>

          <div class="form-field">
            <label for="budget-description">Cuéntame brevemente qué necesitas <span aria-hidden="true">*</span></label>
            <textarea
              id="budget-description"
              name="description"
              rows="6"
              required
              aria-describedby="budget-description-help"
            ></textarea>
            <span class="field-help" id="budget-description-help">
              No hace falta que utilices términos técnicos. Explícame qué quieres conseguir y para qué necesitas la web.
            </span>
          </div>

          <fieldset class="form-section">
            <legend>¿Tienes un presupuesto orientativo?</legend>
            <p class="field-help">Es opcional. Si aún no lo sabes, puedes dejarlo en blanco.</p>
            <div class="choice-grid budget-choice-grid">
              {budgetRanges.map((range) => (
                <label class="choice-card">
                  <input type="radio" name="budget-range" value={range} />
                  <span>{range}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="form-section">
            <legend>¿Cuándo te gustaría tenerlo?</legend>
            <div class="choice-grid">
              {timelines.map((timeline) => (
                <label class="choice-card">
                  <input type="radio" name="timeline" value={timeline} />
                  <span>{timeline}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="form-bottom">
            <p>
              No necesitas tenerlo todo decidido. Con esta información puedo hacerme una primera
              idea y contactar contigo para hablar del proyecto.
            </p>
            <button class="btn-primary form-submit" type="button" data-static-submit>
              Solicitar presupuesto
            </button>
            <p class="form-status" data-form-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
  </main>
  <StaticFormNotice />
</Layout>

<script>
  const websiteOptions = document.querySelectorAll<HTMLInputElement>('input[name="current-website"]');
  const websiteField = document.querySelector<HTMLElement>(".website-url");

  const updateWebsiteField = () => {
    if (!websiteField) return;
    const selected = document.querySelector<HTMLInputElement>('input[name="current-website"]:checked');
    websiteField.hidden = selected?.value !== "yes";
  };

  updateWebsiteField();
  websiteOptions.forEach((option) => option.addEventListener("change", updateWebsiteField));
</script>

<style>
  .section-eyebrow {
    color: var(--accent-start);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.035em;
  }

  .budget-layout {
    display: grid;
    align-items: start;
    gap: 2rem;
  }

  .budget-aside {
    max-width: 440px;
  }

  .budget-aside h2 {
    margin-top: 0.65rem;
    font-size: clamp(1.55rem, 3vw, 2rem);
    line-height: 1.25;
  }

  .budget-aside > p {
    margin-top: 0.8rem;
    color: var(--color-text-soft);
    line-height: 1.7;
  }

  .budget-points {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.5rem;
    list-style: none;
  }

  .budget-points li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-soft);
  }

  .budget-points li span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    flex: 0 0 auto;
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    border-radius: 50%;
  }

  .budget-form {
    display: grid;
    gap: 1.6rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .form-section {
    min-width: 0;
    border: 0;
  }

  .form-section legend {
    margin-bottom: 0.65rem;
    font-size: 1.02rem;
    font-weight: 700;
  }

  .field-help {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-text-mute);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-field label {
    font-size: 0.92rem;
    font-weight: 600;
  }

  .optional {
    color: var(--color-text-mute);
    font-size: 0.82rem;
    font-weight: 400;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.85rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) - 0.2rem);
    font: inherit;
  }

  .form-field textarea {
    min-height: 150px;
    resize: vertical;
  }

  .choice-grid,
  .choice-inline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  .choice-card {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 48px;
    padding: 0.7rem 0.8rem;
    color: var(--color-text-soft);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) - 0.2rem);
    cursor: pointer;
    font-size: 0.91rem;
    line-height: 1.4;
    transition: border-color var(--transition), background var(--transition);
  }

  .choice-card:has(input:checked) {
    color: var(--color-text);
    background: rgba(99, 102, 241, 0.08);
    border-color: var(--accent-mid);
  }

  .choice-card input {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    accent-color: var(--accent-mid);
  }

  .choice-card:focus-within {
    outline: 2px solid var(--accent-start);
    outline-offset: 2px;
  }

  .website-url {
    margin-top: 1rem;
  }

  .website-url[hidden] {
    display: none;
  }

  .form-bottom {
    display: grid;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .form-bottom > p:first-child {
    color: var(--color-text-soft);
    line-height: 1.7;
  }

  .form-submit {
    justify-content: center;
    min-height: 50px;
  }

  .form-status {
    color: var(--color-text-soft);
    font-size: 0.9rem;
  }

  .form-status:empty {
    display: none;
  }

  @media (min-width: 620px) {
    .form-grid,
    .choice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .choice-inline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .budget-layout {
      grid-template-columns: minmax(250px, 0.75fr) minmax(0, 1.25fr);
      gap: 4rem;
    }
  }
</style>
