---
// Client-facing outcomes only — no technical jargon presented as a benefit.
const benefits = [
  "Diseño adaptado a tu negocio, no una plantilla genérica",
  "Se ve bien en el móvil, la tablet y el ordenador",
  "Carga rápida, sin esperas innecesarias",
  "Fácil de usar, tanto para ti como para tus visitantes",
  "Preparada para que te encuentren en Google",
  "Sin funcionalidades de más que solo complican las cosas",
  "Se puede ampliar más adelante si tu negocio crece",
  "Trato directo conmigo durante todo el proceso",
];
---

<section class="section benefits">
  <div class="container">
    <h2 class="benefits-title">Qué obtienes</h2>

    <ul class="benefits-list">
      {
        benefits.map((text) => (
          <li class="benefit-item">
            <svg
              class="benefit-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <span>{text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .benefits-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .benefits-list {
    list-style: none;
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 2rem;
  }

  @media (min-width: 640px) {
    .benefits-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--color-text);
  }

  .benefit-icon {
    flex-shrink: 0;
    color: var(--accent-start);
    margin-top: 0.1rem;
  }
</style>
