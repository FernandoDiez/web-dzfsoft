---
// Helps the visitor self-identify with a profile and see the matching solution.
const matches = [
  { profile: "Tengo un pequeño negocio o comercio", solution: "Página web profesional" },
  { profile: "Soy autónomo y ofrezco servicios", solution: "Web de servicios" },
  { profile: "Tengo o quiero montar una tienda", solution: "Tienda online" },
  { profile: "Ya tengo web, pero está anticuada", solution: "Rediseño de tu web" },
  { profile: "Necesito algo muy específico", solution: "Desarrollo a medida" },
];
---

<section class="section finder">
  <div class="container">
    <h2 class="finder-title">¿Qué tipo de web necesitas?</h2>
    <p class="finder-lead">Elige la frase que más se parezca a tu situación.</p>

    <div class="finder-list">
      {
        matches.map((item) => (
          <div class="finder-row">
            <span class="finder-profile">{item.profile}</span>
            <svg
              class="finder-arrow"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
            <span class="finder-solution">{item.solution}</span>
          </div>
        ))
      }
    </div>

    <p class="finder-note">
      ¿No lo tienes claro todavía? No pasa nada, es lo más normal.
      <a href="/presupuesto" class="finder-link">Cuéntame tu caso y te oriento</a>.
    </p>
  </div>
</section>

<style>
  .finder-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .finder-lead {
    margin-top: 0.75rem;
    color: var(--color-text-soft);
  }

  .finder-list {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .finder-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius);
  }

  @media (max-width: 640px) {
    .finder-row {
      grid-template-columns: 1fr;
      justify-items: start;
      text-align: left;
    }

    .finder-arrow {
      transform: rotate(90deg);
    }
  }

  .finder-profile {
    color: var(--color-text-soft);
    font-size: 0.95rem;
  }

  .finder-arrow {
    color: var(--accent-mid);
    justify-self: center;
  }

  .finder-solution {
    font-weight: 600;
    color: var(--color-text);
    justify-self: end;
  }

  @media (max-width: 640px) {
    .finder-solution {
      justify-self: start;
    }
  }

  .finder-note {
    margin-top: 2rem;
    color: var(--color-text-soft);
    font-size: 0.95rem;
  }

  .finder-link {
    color: var(--accent-start);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
