---
import { getLang, useTranslations, getLocalePath } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="hero section">
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-tag">{t('hero.tag')}</span>
      <h1 class="hero-headline">
        {t('hero.headline').split('\n').map((line, i) => (
          i === 0
            ? <span>{line}<br /></span>
            : <span class="gradient-text">{line}</span>
        ))}
      </h1>
      <p class="hero-sub">{t('hero.sub')}</p>
      <div class="hero-actions">
        <a href={getLocalePath(lang, 'contact')} class="btn-primary">
          {t('hero.cta')}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={`${getLocalePath(lang)}#services`} class="btn-ghost">
          {t('hero.secondary')}
        </a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="code-window">
        <div class="code-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="code-filename">project.ts</span>
        </div>
        <pre class="code-body"><code><span class="kw">const</span> <span class="var">project</span> = <span class="brace">&#123;</span>
  <span class="key">client</span>: <span class="str">"Your business"</span>,
  <span class="key">goal</span>: <span class="str">"Ship faster"</span>,
  <span class="key">stack</span>: [<span class="str">"React"</span>, <span class="str">"Astro"</span>],
  <span class="key">quality</span>: <span class="num">100</span>,
<span class="brace">&#125;</span>;

<span class="kw">export default</span> dzfsoft.<span class="fn">build</span>(project);</code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: radial-gradient(ellipse 80% 60% at 60% -10%, rgba(124, 58, 237, 0.12) 0%, transparent 70%),
                var(--color-bg);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-start);
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: 2rem;
    padding: 0.3rem 0.85rem;
    width: fit-content;
  }

  .hero-headline {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--color-text-soft);
    line-height: 1.7;
    max-width: 520px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* Code window */
  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .code-window {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius);
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-soft);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green { background: #28c840; }

  .code-filename {
    margin-left: 0.5rem;
    font-size: 0.78rem;
    color: var(--color-text-mute);
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
  }

  .code-body {
    padding: 1.25rem 1.25rem 1.5rem;
    margin: 0;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Courier New', monospace;
    font-size: 0.82rem;
    line-height: 1.8;
    overflow-x: auto;
  }

  .code-body code { background: none; }

  .kw  { color: #c792ea; }
  .var { color: #82aaff; }
  .key { color: #f07178; }
  .str { color: #c3e88d; }
  .num { color: #f78c6c; }
  .fn  { color: #82aaff; }
  .brace { color: var(--color-text-soft); }
</style>
