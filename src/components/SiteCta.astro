---
interface Props {
  title: string;
  description: string;
  label?: string;
  href?: string;
}

const {
  title,
  description,
  label = "Pedir presupuesto",
  href = "/presupuesto",
} = Astro.props;
---

<section class="section site-cta-section">
  <div class="container site-cta">
    <h2 class="site-cta-title">{title}</h2>
    <p class="site-cta-description">{description}</p>
    <a class="btn-primary site-cta-button" href={href}>{label}</a>
  </div>
</section>

<style>
  .site-cta-section {
    padding-top: 2rem;
  }

  .site-cta {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .site-cta-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .site-cta-description {
    max-width: 560px;
    color: var(--color-text-soft);
    line-height: 1.7;
  }

  .site-cta-button {
    justify-content: center;
    min-height: 48px;
    margin-top: 0.25rem;
  }
</style>
