---
import { getLang, useTranslations, getLocalePath } from '../i18n/utils';
import { languages, type Lang } from '../i18n/translations';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

// Build alternate language URL
const altLang = (lang === 'en' ? 'es' : 'en') as Lang;
const currentPath = Astro.url.pathname.replace(/^\/(en|es)/, '') || '/';
const altHref = getLocalePath(altLang, currentPath);
---

<header class="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href={getLocalePath(lang)} class="logo" aria-label="dzf soft — Home">
      <span class="logo-mark" aria-hidden="true">⬡</span>
      <span class="logo-text">dzf <span class="logo-soft">soft</span></span>
    </a>

    <!-- Desktop nav -->
    <nav class="nav-desktop" aria-label="Main navigation">
      <a href={getLocalePath(lang)}>{t('nav.home')}</a>
      <a href={`${getLocalePath(lang)}#services`}>{t('nav.services')}</a>
      <a href={`${getLocalePath(lang)}#about`}>{t('nav.about')}</a>
      <a href={getLocalePath(lang, 'contact')} class="nav-cta">{t('nav.contact')}</a>
    </nav>

    <!-- Right controls -->
    <div class="header-controls">
      <!-- Language switcher -->
      <a href={altHref} class="lang-switch" aria-label={`Switch to ${languages[altLang]}`}>
        {altLang.toUpperCase()}
      </a>

      <!-- Theme toggle -->
      <button id="theme-toggle" aria-label="Toggle dark/light mode" class="icon-btn">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Mobile menu toggle -->
      <button id="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" class="icon-btn mobile-only">
        <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav drawer -->
  <nav id="mobile-nav" class="nav-mobile hidden" aria-label="Mobile navigation">
    <a href={getLocalePath(lang)}>{t('nav.home')}</a>
    <a href={`${getLocalePath(lang)}#services`}>{t('nav.services')}</a>
    <a href={`${getLocalePath(lang)}#about`}>{t('nav.about')}</a>
    <a href={getLocalePath(lang, 'contact')} class="nav-cta">{t('nav.contact')}</a>
  </nav>
</header>

<script>
  // Theme toggle
  const toggleBtn = document.getElementById('theme-toggle');
  const html = document.documentElement;

  function updateThemeIcons() {
    const isDark = html.classList.contains('dark');
    document.querySelector('.icon-sun')?.classList.toggle('hidden', isDark);
    document.querySelector('.icon-moon')?.classList.toggle('hidden', !isDark);
  }

  updateThemeIcons();

  toggleBtn?.addEventListener('click', () => {
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    updateThemeIcons();
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileNav?.classList.contains('hidden');
    mobileNav?.classList.toggle('hidden', isOpen);
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
    document.querySelector('.icon-menu')?.classList.toggle('hidden', !isOpen);
    document.querySelector('.icon-close')?.classList.toggle('hidden', isOpen);
  });

  // Close mobile menu on nav link click
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      document.querySelector('.icon-menu')?.classList.remove('hidden');
      document.querySelector('.icon-close')?.classList.add('hidden');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background var(--transition), border-color var(--transition);
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-text);
    transition: opacity var(--transition);
    flex-shrink: 0;
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo-mark {
    font-size: 1.3rem;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .logo-soft {
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Desktop nav */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .nav-desktop {
      display: flex;
    }
  }

  .nav-desktop a {
    padding: 0.4rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-soft);
    transition: color var(--transition), background var(--transition);
  }

  .nav-desktop a:hover {
    color: var(--color-text);
    background: var(--color-bg-mute);
  }

  .nav-desktop a.nav-cta,
  .nav-mobile a.nav-cta {
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    color: #fff !important;
    padding: 0.4rem 1rem;
    border-radius: 0.5rem;
    font-weight: 600;
  }

  .nav-desktop a.nav-cta:hover {
    background: var(--color-bg-mute);
    opacity: 0.9;
  }

  /* Controls */
  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .lang-switch {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-mute);
    padding: 0.35rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }

  .lang-switch:hover {
    color: var(--color-text);
    border-color: var(--accent-mid);
    background: var(--color-bg-mute);
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-soft);
    cursor: pointer;
    transition: color var(--transition), background var(--transition), border-color var(--transition);
  }

  .icon-btn:hover {
    color: var(--color-text);
    background: var(--color-bg-mute);
    border-color: var(--accent-mid);
  }

  .mobile-only {
    display: flex;
  }

  @media (min-width: 768px) {
    .mobile-only {
      display: none;
    }
  }

  /* Mobile nav */
  .nav-mobile {
    border-top: 1px solid var(--color-border);
    padding: 1rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-mobile a {
    padding: 0.65rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-soft);
    transition: color var(--transition), background var(--transition);
  }

  .nav-mobile a:hover {
    color: var(--color-text);
    background: var(--color-bg-mute);
  }

  .hidden {
    display: none !important;
  }
</style>
