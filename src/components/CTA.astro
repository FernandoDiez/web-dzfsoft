---
import { getLang, useTranslations, getLocalePath } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="cta-section section">
  <div class="container cta-inner">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="cta-content">
      <h2 class="cta-title">{t('cta.title')}</h2>
      <p class="cta-sub">{t('cta.sub')}</p>
      <a href={getLocalePath(lang, 'contact')} class="btn-primary cta-btn">
        {t('cta.btn')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--color-bg);
  }

  .cta-inner {
    position: relative;
    text-align: center;
    overflow: hidden;
    border-radius: calc(var(--radius) * 2);
    border: 1px solid var(--color-border);
    background: var(--color-card-bg);
    padding: 4rem 2rem;
  }

  .cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(124, 58, 237, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-title {
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.2;
  }

  .cta-sub {
    font-size: 1rem;
    color: var(--color-text-soft);
    max-width: 440px;
    line-height: 1.7;
  }

  .cta-btn {
    font-size: 1rem;
    padding: 0.85rem 2rem;
  }
</style>
